---
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout>
	<section class = 'hero'>
		<p class = 'eyebrow'>C:\Users\b00kworm4lyfe&gt;</p>
		<h1>Hi, I'm Sage!</h1>
		<h2>Technical Artist and Creative Technologist</h2>
		<a class = 'button1' href="/work">my work</a>
	</section>

	<style>
		
		.hero{
			flex: 1;
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding-left: 20%;
			align-items: flex-start;
		}
		.button1{
			margin-left: 1.5em;
		}
		h1{
			background: linear-gradient(150deg, var(--grn-neon), var(--grn-light));
			-webkit-background-clip: text;
			background-clip: text;

			color: transparent;
			font-size: 5em;
			margin-bottom: 0;
			margin-top: 0;

			padding-top: 0;
			padding-left: 0.25em;
		}
		h2{
			margin-top: 0;
			padding-left: 1em;
		}
		.eyebrow{
			font-family: 'Space Mono', monospace;
			color: var(--grn-lightest);
			padding-bottom: 0;
			margin-bottom: 0;
		}
		.eyebrow::after{
			content: '|';
			animation: blink 1s steps(1) infinite;
			margin-left: 0.5em;
		}
	</style>
</BaseLayout>
